# =============================================================================
# Projeto 2 (demo fictícia) — Integração Sistema de Campo → ERP
# Copie este arquivo para `.env` e ajuste os valores.
# O `.env` fica fora do versionamento (ver .gitignore) — nenhum segredo real:
# todos os defaults abaixo são valores FICTÍCIOS criados para a demo local.
# =============================================================================

# --- Oracle XE (container campo-erp-oracle) -----------------------------------
# Senha do usuário SYSTEM (OBRIGATÓRIA). No primeiro boot, db/01_schema.sql
# cria também os usuários fictícios INTEGRACAO e ERP_SUPRIMENTOS com as senhas
# literais abaixo — para trocá-las é preciso editar db/01_schema.sql (e
# recriar o volume) OU alterar as senhas no banco depois do boot.
ORACLE_PASSWORD=TroqueEstaSenhaFicticia2026

# Senhas dos usuários fictícios criadas por db/01_schema.sql no 1º boot.
# Devem casar com os literais do script para o integrador/painel conectarem.
INT_ORACLE_SENHA=IntegracaoFicticia2026
PAINEL_ORACLE_SENHA=IntegracaoFicticia2026

# --- Simulador do Sistema de Campo (Módulo A, porta 8001) ---------------------
# CAMPO_API_KEY: chave exigida no header X-API-Key de TODAS as rotas, exceto
#               GET /health. A mesma chave é usada pelo integrador (origem).
CAMPO_API_KEY=campo-dev-key-001
# CAMPO_DB_PATH: caminho do SQLite dentro do container (relativo a /app).
CAMPO_DB_PATH=data/simulador.db

# --- Serviço de Integração (Módulo B, porta 8002) ------------------------------
# INT_ORACLE_DSN: dentro do compose o host é o nome do serviço ("oracle");
#                fora do compose (uvicorn local) use localhost:1521/XEPDB1.
INT_ORACLE_DSN=oracle:1521/XEPDB1
INT_ORACLE_USUARIO=INTEGRACAO
# INT_CAMPO_URL: URL da origem (simulador) — "simulador" na rede do compose.
INT_CAMPO_URL=http://simulador:8001
INT_CAMPO_API_KEY=campo-dev-key-001
# INT_API_KEY: chave da API administrativa do integrador (exceto GET /health).
INT_API_KEY=integrador-dev-key-001

# Opcionais do integrador (defaults em integrador/config.py): ciclo a cada 5 min,
# reprocessador a cada 2 min, máximo 3 tentativas, alerta de peso 60000 kg,
# tolerância de futuro 5 min, timeout HTTP 10 s, página de 100 registros.
# INT_CICLO_INTERVALO_MIN=5
# INT_REPROC_INTERVALO_MIN=2
# INT_MAX_TENTATIVAS=3
# INT_PESO_LIMITE_ALERTA=60000
# INT_TOLERANCIA_FUTURO_MIN=5
# INT_TIMEOUT_HTTP_SEG=10
# INT_LIMITE_PAGINA=100

# --- Painel de Conciliação (Módulo C, porta 8501) -----------------------------
PAINEL_ORACLE_DSN=oracle:1521/XEPDB1
PAINEL_ORACLE_USUARIO=INTEGRACAO
# PAINEL_INTEGRADOR_URL: usada na ação de reprocessamento (POST /reprocessar).
PAINEL_INTEGRADOR_URL=http://integrador:8002
PAINEL_INTEGRADOR_API_KEY=integrador-dev-key-001
# Auto-refresh do painel em segundos (0 = desligado).
PAINEL_AUTO_REFRESH_SEG=0
